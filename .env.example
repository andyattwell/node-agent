ADW_AI_PROVIDER=llama_cpp # pi | cursor | claude | custom| none

# App repository (separate from ADW). Cloned into app/ when missing.
ADW_APP_REPO_URL=
ADW_BASE_BRANCH=origin/main

DATABASE_PATH=.data/jobs.sqlite

# Default SQLite project id for prompt-only ADW runs (optional)
ADW_PROJECT_ID=1

# cursor agent
# claude claude
# custom http://localhost:11434
ADW_AI_PATH=
ADW_AI_MODEL=

OLLAMA_TIMEOUT_MS=600000 # 10 

# Used to start llama-server
# LLAMA_CPP_PATH=
# LLAMA_SERVER_PORT

# Anthropic variables
ANTHROPIC_API_KEY=""

# Llama tools variables
# Tools max read size in bytes (optional; defaults to 5 MB).
MAX_READ_SIZE_BYTES=5242880

# Tools max write size in bytes (optional; defaults to 5 MB).
MAX_WRITE_SIZE_BYTES=5242880

# Tools max list entries (optional; defaults to 500).
MAX_LIST_ENTRIES=500

# Tools max search results (optional; defaults to 100).
MAX_SEARCH_RESULTS=100

CLICKUP_PERSONAL_TOKEN=
CLICKUP_EMAIL=
CLICKUP_USER_ID=

ADW_GEMINI_API_KEY=